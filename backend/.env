# Configuración del Gateway
BENNER_AI_PORT=8888
BENNER_AI_HOST=0.0.0.0
BENNER_AI_ENV=production

# Reglas de Hardware e Inferencias de IA (GEMINI.md)
OLIVE_GPU_MEMORY_LIMIT=20
OLIVE_CPU_THREADS=12
DIRECTML_BACKEND=1

# Repositorio Maestro de Modelos
MODELS_ROOT=C:\antigravityAS\Modelos -ai-brains
BIBLIOTECA_ROOT=C:\antigravityAS\BennerAI\biblioteca

# Puertos de Servicios Conectados
