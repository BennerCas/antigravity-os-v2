FALLBACK_LLM_MODEL=qwen2.5-coder:latest
DEFAULT_IMAGE_MODEL=flux
DEFAULT_TTS_MODEL=kokoro-tts
DEFAULT_STT_MODEL=whisper-v3
OLLAMA_KEEP_ALIVE=0

# Gestión de Memoria
MAX_RAM_THRESHOLD_PERCENT=88.0
AUTO_CLEAN_INTERVAL_SECONDS=300

