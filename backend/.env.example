# The Vault - Environment Configuration
# Copia este archivo como .env y rellena los valores reales

# --- Motor de IA (requerido) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Alternativa OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Integraciones ---
GITHUB_TOKEN=your_github_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AZURE_OPENAI_KEY=your_azure_openai_key_here

# --- App ---
DEBUG=False
ENVIRONMENT=development
VAULT_SECRET_KEY=your_encryption_key_here

# --- Modelo activo: "gemini" | "openai" | "local" ---
ACTIVE_MODEL=gemini
GEMINI_MODEL=gemini-1.5-flash
